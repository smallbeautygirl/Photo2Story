# Copy to .env and fill in. .env is gitignored — never commit real values.
# Authentication uses Application Default Credentials, not an API key:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# fal.ai API key, used by src/stages/illustrate_fal.py for FLUX illustration generation.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=your-fal-api-key

# LLM backend selection. Routed by model name: names starting with "gemini" go to
# Vertex AI, anything else (e.g. gemma4:31b-it-q4_K_M) to the Ollama server below.
# Set LLM_BACKEND=gemini or LLM_BACKEND=ollama to force one regardless of model name.
# LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
